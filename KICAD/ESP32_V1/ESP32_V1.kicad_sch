	(text "D32->470R->D33 loop A      D32->470R->D33 loop A      D25->470R->D26 loop B\nD27->10k/100nF->D34 + MCP3008 CH0\n\nI2C D21/D22, INT D35 via SEL_D35, FB D39\nSPI SCK/MISO/MOSI D18/D19/D23, CS ADC D16, CS flash D17\n\nOneWire D13\nUART1 TX D4 / RX D35; UART2 TX D14 / RX D36\nD35 selects I2C INT or UART1 RX; UART0 D1/D3 reserved for REPL/flashing\n\nNo fixed loads on D0/D2/D5/D12/D15.\nD6-D11 are module-flash signals and must not be used."
		(exclude_from_sim no)
		(at 19.05 278.13 0)
		(effects
			(font
				(size 1.524 1.524)
				(thickness 0.3048)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "aff39425-3093-42a1-ab47-61edf1b54a09")
	)
