	(text "OLIMEX ESP32-S3-DEVKIT-LIPO-EA REV B — N8R8\n\nROUTED:\nR0=D1, R1=D4, R2=D15, R3=D16\nR4=D7, R5=D8, R6=D9\n\nDIRECT:\nI2C SDA/SCL = D10/D11\nUART-B TX/RX = D17/D18\nRESET_N = ESP_EN; BOOT_REQUEST = D0\n\nD5/PWR_SENS and D6/BAT_SENS deliberately remain unused.\npUEXT must be absent or unconnected during mapped tests.\n\nCONTROLLED-POWER TEST:\nDisconnect LiPo and remove or isolate both USB VBUS sources.\nTI_TARGET_3V3 is target-generated and must not be driven externally."
		(exclude_from_sim no)
		(at 320.04 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "924ffd58-4c8b-42ae-bc26-3eefecbc697e")
	)
