	(text "FUNCTIONAL FLOW\n\nTarget open-drain GPIO ↔ TI_ONEWIRE_DQ \n       ↔ J501/J502 DS18B20 sensors\n       ↔ J504 DS2413 module\n\nJ504 PIOA → R505 → TI_ONEWIRE_GPIO_A_FB\nJ504 PIOB → R506 → TI_ONEWIRE_GPIO_B_FB"
		(exclude_from_sim no)
		(at 375.92 325.12 0)
		(effects
