		(uuid "c7000000-0000-4000-8000-000000000009")
	)
	(text "R705-R708 are fitted safety components:\nthey supplement the TMUX1511 internal pull-downs and\nkeep all four UART paths open during \nrouting-controller reset or loss of control."
		(exclude_from_sim no)
		(at 31.75 339.09 0)
		(effects
