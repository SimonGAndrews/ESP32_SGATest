		(uuid "062f684e-0fb5-4a76-9f22-75cf72bc812a")
	)
	(text "J302 exposes GPA0–GPA7 and GPB0–GPB7 for\nobservation and experiments.\nGPA7 and GPB7 are output-only on the selected MCP23017.\nDo not externally drive pins already assigned to Block 3 functions."
		(exclude_from_sim no)
		(at 241.3 102.87 0)
