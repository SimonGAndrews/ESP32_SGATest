	(text "Route and verify TI_RGB_DATA before enabling the target output.\nStart with the target output low or high impedance.\nFit or remove the module only with Test Block power off and the route open.\nJ902 supplies 3.3 V only; module-generated 5 V remains module-local.\nTP901 is for high-impedance observation only.\nJ902 and TP901/TP902 are DNP / hand-fit parts."
		(exclude_from_sim no)
		(at 200.66 335.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "01c193af-b3a1-4ec8-8814-0cfcfa2cfbfd")
	)
