	(text "J701 signal names use the peer perspective: \n  UART_PEER_RX receives endpoint-A TX; \n  UART_PEER_TX drives endpoint-A RX.\n\nJ702 is for high-impedance observation only; do not drive pins 1 or 2.\n\nNeither header supplies power; \n  an external peer must use 3.3 V signalling and share TI_GND."
		(exclude_from_sim no)
		(at 111.76 342.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c7000000-0000-4000-8000-000000000008")
	)
