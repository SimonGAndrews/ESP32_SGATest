	)
	(text "MODE_STANDALONE"
		(exclude_from_sim no)
		(at 234.95 92.71 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right bottom)
		)
		(uuid "55b1da4f-8958-439d-ba9f-b861a00c0d7c")
	)
	(text "U1002 - TPS22917DBV\n	Active-high Test Block 3.3 V load switch.\n	C1005 controls turn-on slew and inrush current.\n	QOD discharges TEST_BLOCK_3V3 when disabled.\n	No current limiting or overload protection."
		(exclude_from_sim no)
		(at 318.77 64.77 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7f19bcaa-8396-4bc1-b580-9f4e6743ff3d")
	)
	(text "OFF"
		(exclude_from_sim no)
		(at 72.55 54.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right bottom)
		)
		(uuid "811c7511-4d5b-452b-a5aa-4c14147ed71a")
	)
	(text "Q1101 turns off, inserting the 1 Ω R1102 low-range shunt.\n\nRACK_CONTROL_3V3 or EXT_5V absent:\nU1102 isolates LOW_SHUNT_BYPASS_GATE.\nR1107 pulls it to TI_GND, restoring the hardware-safe R1102 bypass."
		(exclude_from_sim no)
		(at 210.82 278.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "825388f8-c568-4580-b7f5-4ba76411afbb")
	)
	(text "LOW_RANGE_GATE_3V3 = TARGET_LOW_RANGE_EN AND LOW_RANGE_OK_N"
		(exclude_from_sim no)
		(at 48.26 207.01 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 221 133 0 1)
			)
			(justify left)
		)
		(uuid "82e21c6e-faed-4485-afe5-f0f57be456db")
	)
	(text "REVERSE CURRENT BLOCKING\nis provided by U1101 when it is disabled.\nIt prevents current flowing backwards from TI_SWITCHED_TARGET_5V \nthrough U1101 into EXT_5V during Standalone operation"
		(exclude_from_sim no)
		(at 46.99 189.23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8dfae8f9-63f1-4553-945c-cf338598a2ec")
	)
	(text "PCB LAYOUT REQUIREMENT - KELVIN SENSE\n\nDashed wires identify Kelvin sense connections.\nOn the PCB, route each sense trace directly from its shunt pad\nto the corresponding monitor IN+ or IN− pin."
		(exclude_from_sim no)
		(at 269.24 161.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "97212244-8877-439d-bda2-f1beb2d5e877")
	)
	(text "TPS2116 provides static source isolation; no supply transfer occurs during a test.\n"
		(exclude_from_sim no)
		(at 251.46 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9cf8fe72-b6ae-4a24-b4b7-f56e644e459f")
	)
	(text "J1001\nOFF: MODE low, PR1 high -> high-impedance output\nSTANDALONE: MODE high, PR1 high -> TI_TARGET_3V3\nSTANDALONE EXT / SUPERVISOR: MODE high, PR1 low -> EXT_3V3\nChange the Operating Mode shunt only with both 3.3 V sources off."
		(exclude_from_sim no)
		(at 68.58 68.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a101dfe4-9039-445a-96aa-c38f89579ec8")
	)
	(text "SUPERVISOR"
		(exclude_from_sim no)
		(at 80.85 47.17 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right bottom)
		)
		(uuid "a5987dd6-e6d1-464b-a908-42fa69d157cc")
	)
	(text "TARGET 5 V SWITCH AND TWO-RANGE POWER MONITOR"
		(exclude_from_sim no)
		(at 46.99 128.27 0)
		(effects
			(font
				(size 2.032 2.032)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "b61e842d-e1b4-48c0-adae-1de98e26ddcc")
	)
	(text "LOW_SHUNT_BYPASS_GATE"
		(exclude_from_sim no)
		(at 227.33 171.45 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
				(color 0 194 0 1)
			)
			(justify left bottom)
		)
		(uuid "bd84edfc-695e-4144-93f4-f8b70930ccfb")
	)
	(text "LOW-RANGE SAFETY INTERLOCK\n\nLOW_RANGE_OK_N is the INA228 active-low, latched over-current alert.\nIt qualifies TARGET_LOW_RANGE_EN through U1105.\n\nLOW_RANGE_OK_N high: low-range selection may remain enabled.\nLOW_RANGE_OK_N low: U1105 disables the low-range drive, restoring\nQ1101’s hardware-safe normal-range bypass.\n\nThe signal also feeds U1201 GPB3, allowing RACK_INT_N to notify\nthe supervisor. Firmware clears TARGET_LOW_RANGE_EN before reading\nINA228 DIAG_ALRT to release the latched alert."
		(exclude_from_sim no)
		(at 312.42 231.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bf5e1c27-5b3e-439f-ac3d-e57dd7bea81e")
	)
	(text "TEST_BLOCK_SWITCH_EN high\n    -> ROUTING_LOGIC_3V3 is passed to TEST_BLOCK_3V3\n\nTEST_BLOCK_SWITCH_EN low\n    -> TEST_BLOCK_3V3 is switched off and discharged"
		(exclude_from_sim no)
		(at 323.85 77.47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c340e908-8006-4e82-a459-4c71c5425990")
	)
	(text "U1001 - TPS22917\nUltra-Low Leakage Load Switch"
		(exclude_from_sim no)
		(at 351.79 95.25 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c3acfea8-d03c-457c-8317-224573774898")
	)
	(text "C0G/NP0, ±10% or better\n10 V minimum,"
		(exclude_from_sim no)
		(at 293.37 52.07 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c8001da5-e8b6-4bb8-992f-6a088dd21216")
	)
	(text "TEST_BLOCK_SWITCH_EN"
		(exclude_from_sim no)
		(at 307.35 89.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c951489e-4df1-4b00-a8a7-494317c99504")
	)
	(text "R1001, R1003 and R1004 hold MODE, the inverter gate and Test Block enable low when undriven"
		(exclude_from_sim no)
		(at 45.72 95.25 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d2e7c880-e8e9-4d02-84f2-e9996f199183")
	)
	(text "KELVIN SENSE"
		(exclude_from_sim no)
		(at 170.1231 187.5374 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d5a201e1-b8cc-487d-b7e5-528bfd5280fa")
	)
	(text "Selects address 0x40"
		(exclude_from_sim no)
		(at 223.52 195.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d5d0e645-164b-4128-840b-2c6c718b80cf")
	)
	(text "MODE_EXT_SELECTED"
		(exclude_from_sim no)
		(at 179.07 77.47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e40cce69-585e-4a7d-b798-442965b0190e")
	)
	(text "| Device| OR inputs                                   |       Output           |                                                                                   |                                                           \n|-------|---------------------------------------------|------------------------|-----------------------------------------------------------------------------------|\n| D1001 |  MODE_STANDALONE_EXT ,  MODE_SUPERVISOR     |  MODE_EXT_SELECTED     | Indicates that U1001 must use the external 3.3 V supply.                          |\n| D1002 |  MODE_STANDALONE ,  MODE_EXT_SELECTED       |  MUX_MODE              | Enables U1001 in every active operating mode; remains low in OFF                  |\n| D1003 |  TI_TARGET_3V3 ,  EXT_3V3                   |  MODE_BIAS_3V3         | Supplies the low-current bias used to establish U1001 s source-selection state.   |\n| D1004 |  MODE_STANDALONE ,  MODE_STANDALONE_EXT     |  TEST_BLOCK_AUTO_EN    | Automatically requests Test Block power in either standalone mode.                |\n| D1005 |  TEST_BLOCK_AUTO_EN ,  TEST_BLOCK_POWER_EN  |  TEST_BLOCK_SWITCH_EN  | Enables U1002 from either the standalone automatic request or Supervisor command. |"
		(exclude_from_sim no)
		(at 45.72 105.41 0)
		(effects
			(font
				(face "Consolas")
				(size 1.524 1.524)
			)
			(justify left)
		)
		(uuid "ea750404-4e77-4bfc-8d2d-c8713752e1e3")
	)
	(text "** Required firmware sequence for low-range power measurement:\n\n1. Use the INA226 to confirm normal-range current is below the low-range threshold.\n2. Set TARGET_LOW_RANGE_EN = 1 and confirm its MCP23017 GPIO readback.\n3. Wait for an INA228 conversion and confirm its status and current reading are valid.\n4. Measure sleep current using the INA228.\n5. Set TARGET_LOW_RANGE_EN = 0 before wake or reset."
		(exclude_from_sim no)
		(at 46.99 275.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ef19f629-eddf-43f1-91b5-845b90e8bf92")
	)
	(text "MODE_STANDALONE"
		(exclude_from_sim no)
		(at 179.07 72.39 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f20c769e-6881-4d57-8406-9809bbeb1379")
	)
	(text "In Supervisor mode, this block switches EXT_5V to the target with controlled turn-on,\nresistor-programmed current limiting, fault reporting, and normal or sleep-current measurement.\n\nThe normal/high-current measurement range is the hardware-safe default.\nReverse-current blocking while disabled permits independent Standalone target power."
		(exclude_from_sim no)
		(at 48.26 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f7c2311f-9119-4f34-a3fc-d0ba31505526")
	)
	(text "U1001 \nselects the ROUTING_LOGIC_3V3 source:\n	OFF               -> output disabled\n	STANDALONE        -> TI_TARGET_3V3\n	STANDALONE EXT    -> EXT_3V3\n	SUPERVISOR        -> EXT_3V3\n"
		(exclude_from_sim no)
		(at 247.65 105.41 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f86bcf65-1b77-4908-82d1-8ec4a5778d02")
	)
	(text "U1102 drives LOW_SHUNT_BYPASS_GATE high\n        ↓\nQ1101 turns off\n        ↓\nR1102 (1 Ω) is inserted for low-current measurement"
		(exclude_from_sim no)
		(at 50.8 217.17 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "fd8b45c2-a360-4be1-ab41-32d9c450e9d7")
	)
