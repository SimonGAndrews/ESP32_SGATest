		)
		(uuid "d5a201e1-b8cc-487d-b7e5-528bfd5280fa")
	)
	(text "Selects address 0x40"
		(exclude_from_sim no)
		(at 223.52 195.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d5d0e645-164b-4128-840b-2c6c718b80cf")
	)
	(text "Note LoopBack from Pin 6"
		(exclude_from_sim no)
		(at 168.91 87.63 0)
		(effects
