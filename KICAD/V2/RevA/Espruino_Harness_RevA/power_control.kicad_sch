		(uuid 9c9dd358-a583-4e11-a506-42035196155a)
	)
	(text "SAFE STATE\n\nR1003 holds LOCAL_REG_ENABLE low.\nR1009 holds MODE_SUPERVISOR low while its driver is unpowered.\nR1004 holds U1002 disabled.\nU1003 discharges LOCAL_REG_VIN and U1002 discharges TEST_BLOCK_3V3 when disabled."
		(exclude_from_sim no)
		(at 128.27 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "00f99bd5-ec00-45d3-bd67-1a7e172055b7")
	)
	(text "U1102 TXU0101DBVR behaviour:\n\nLOW_RANGE_GATE_3V3 = 0:\nU1102 leaves LOW_SHUNT_BYPASS_GATE high-impedance.\nR1107 pulls LOW_SHUNT_BYPASS_GATE to TI_GND, turning Q1101 on and bypassing R1102.\n\nLOW_RANGE_GATE_3V3 = 1, with RACK_CONTROL_3V3 and EXT_5V present:"
		(exclude_from_sim no)
		(at 210.82 261.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "01a9b22d-cc0c-4315-80e0-b7df4c5e5944")
	)
	(text "OPERATING MODE — FIT TWO SHUNTS; CHANGE ONLY WHILE UNPOWERED\n\nMode          J1001 shunts   Routing source   Local regulator     Test Block supply\nStandalone    1–3 and 2–4    LOCAL_3V3        Enabled             Automatic\nSupervisor     3–5 and 4–6    EXT_3V3          Disabled/isolated   TEST_BLOCK_POWER_EN"
		(exclude_from_sim no)
		(at 260.35 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "030c710f-7122-4a3e-8af4-f2a00d07f197")
	)
	(text "KELVIN SENSE"
		(exclude_from_sim no)
		(at 237.49 137.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1402e388-60bd-4c52-9f0d-1ae77d90c294")
	)
	(text "Selects address 0x41"
		(exclude_from_sim no)
		(at 328.93 198.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1672db07-8055-4241-ad80-bb0868101085")
	)
	(text "LOW-RANGE power measurment BYPASS CONTROL\nQ1101 bypasses R1102 by default.\n"
		(exclude_from_sim no)
		(at 46.99 198.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1fe53960-4ceb-4e53-91ca-1267eaa7f660")
	)
	(text " LOW_RANGE_GATE_3V3 = TARGET_LOW_RANGE_EN AND LOW_RANGE_OK_N"
		(exclude_from_sim no)
		(at 82.55 209.55 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 194 0 0 1)
			)
		)
		(uuid "231a5959-5852-4691-a36d-8ac870265aff")
	)
	(text "POWER CONTROL SERVICE - OPERATING MODE AND 3.3 V RAIL"
		(exclude_from_sim no)
		(at 45.72 17.78 0)
		(effects
			(font
				(size 2.032 2.032)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "2f8e819d-46ba-4301-88e1-b5636f40bcdf")
	)
	(text "** Circuit Logic Sequence for low range power measurment:\nU1105\n"
		(exclude_from_sim no)
		(at 46.99 203.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "319c9709-7c50-45c1-b23b-b9870b59d2a3")
	)
	(text "Selects LOCAL_3V3 or EXT_3V3 as the ROUTING_LOGIC_3V3 source.\nDerives the operating-mode state and controls automatic or Supervisor-commanded TEST_BLOCK_3V3."
		(exclude_from_sim no)
		(at 48.26 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "35a278d2-0d78-4039-a5cd-da0f6fcc9204")
	)
	(text "TWO-RANGE POWER MONITOR via two I2C device current monitor devices\n\nU1103/INA226 with the 50 mΩ R1101 provides low-loss normal-current\nmeasurement. U1104/INA228 with the 1 Ω R1102 provides more sensitive\nmeasurement of small sleep currents.\n\nTARGET_LOW_RANGE_EN requests the sleep-current range.\nLOW_RANGE_OK_N acts as a hardware safety check and restores the normal\nrange if the current becomes too high. R1102 is bypassed by default.\n\nSee ReusableHarnessRevA_DesignBaseline.md,\nPC02 — Target 5 V switch and two-range power monitor."
		(exclude_from_sim no)
		(at 306.07 138.43 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3cc881af-c1b4-4772-a0c8-e0a05b642085")
	)
	(text "U1102 drives LOW_SHUNT_BYPASS_GATE towards EXT_5V."
		(exclude_from_sim no)
		(at 238.76 270.51 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 194 0 1)
			)
		)
		(uuid "48c391d3-3038-4956-ab7c-1dffe565aa28")
	)
	(text "TARGET_POWER_FAULT_N asserts low on overcurrent or overtemperature."
		(exclude_from_sim no)
		(at 83.82 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4fdbf757-3adc-4cd4-866e-0d19430e3124")
	)
	(text "PCB-CRITICAL PLACEMENT\n\nPlace C1001 and C1006 at U1003; C1002, C1003 and R1005 at U1001;\nC1007 directly at U1004 pins 5 and 2; and C1005/C1004 at U1002.\nKeep regulator power loops, CT connections and QOD discharge paths short."
		(exclude_from_sim no)
		(at 220.98 107.95 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "697f67c2-46f3-4c6c-af25-dcead5ef0b23")
	)
	(text "Q1101 turns off, inserting the 1 Ω R1102 low-range shunt.\n\nRACK_CONTROL_3V3 or EXT_5V absent:\nU1102 isolates LOW_SHUNT_BYPASS_GATE.\nR1107 pulls it to TI_GND, restoring the hardware-safe R1102 bypass."
		(exclude_from_sim no)
		(at 210.82 278.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "825388f8-c568-4580-b7f5-4ba76411afbb")
	)
	(text "LOW_RANGE_GATE_3V3 = TARGET_LOW_RANGE_EN AND LOW_RANGE_OK_N"
		(exclude_from_sim no)
		(at 48.26 207.01 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 221 133 0 1)
			)
			(justify left)
		)
		(uuid "82e21c6e-faed-4485-afe5-f0f57be456db")
	)
	(text "REVERSE CURRENT BLOCKING\nis provided by U1101 when it is disabled.\nIt prevents current flowing backwards from TI_SWITCHED_TARGET_5V \nthrough U1101 into EXT_5V during Standalone operation"
		(exclude_from_sim no)
		(at 46.99 189.23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8dfae8f9-63f1-4553-945c-cf338598a2ec")
	)
	(text "PCB LAYOUT REQUIREMENT - KELVIN SENSE\n\nDashed wires identify Kelvin sense connections.\nOn the PCB, route each sense trace directly from its shunt pad\nto the corresponding monitor IN+ or IN− pin."
		(exclude_from_sim no)
		(at 269.24 161.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "97212244-8877-439d-bda2-f1beb2d5e877")
	)
	(text "U1002 — TPS22917DBVR TEST-BLOCK LOAD SWITCH\n\nC1005 controls turn-on slew and inrush.\nQOD tied to VOUT discharges TEST_BLOCK_3V3 when disabled.\nNo current limiting or overload protection is provided."
		(exclude_from_sim no)
		(at 313.69 107.95 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ad053638-fc31-4c03-8362-925e6e9d42c6")
	)
	(text "FUNCTIONAL FLOW\n\nStandalone:\nTI_TARGET_VBUS → U1003 isolation → U1001 regulator → LOCAL_3V3\n→ J1001 → ROUTING_LOGIC_3V3.\nU1004 asserts TEST_BLOCK_AUTO_EN; D1005 enables U1002.\n\nSupervisor:\nEXT_3V3 → J1001 → ROUTING_LOGIC_3V3.\nU1003 isolates and discharges LOCAL_REG_VIN; U1001 remains disabled.\nD1005 passes TEST_BLOCK_POWER_EN to U1002."
		(exclude_from_sim no)
		(at 46.99 76.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b348ea19-0b53-4ac1-9d49-6ed3429d3054")
	)
	(text "TARGET 5 V SWITCH AND TWO-RANGE POWER MONITOR"
		(exclude_from_sim no)
		(at 46.99 128.27 0)
		(effects
			(font
				(size 2.032 2.032)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "b61e842d-e1b4-48c0-adae-1de98e26ddcc")
	)
	(text "LOW_SHUNT_BYPASS_GATE"
		(exclude_from_sim no)
		(at 227.33 171.45 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
				(color 0 194 0 1)
			)
			(justify left bottom)
		)
		(uuid "bd84edfc-695e-4144-93f4-f8b70930ccfb")
	)
	(text "LOW-RANGE SAFETY INTERLOCK\n\nLOW_RANGE_OK_N is the INA228 active-low, latched over-current alert.\nIt qualifies TARGET_LOW_RANGE_EN through U1105.\n\nLOW_RANGE_OK_N high: low-range selection may remain enabled.\nLOW_RANGE_OK_N low: U1105 disables the low-range drive, restoring\nQ1101’s hardware-safe normal-range bypass.\n\nThe signal also feeds U1201 GPB3, allowing RACK_INT_N to notify\nthe supervisor. Firmware clears TARGET_LOW_RANGE_EN before reading\nINA228 DIAG_ALRT to release the latched alert."
		(exclude_from_sim no)
		(at 312.42 231.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bf5e1c27-5b3e-439f-ac3d-e57dd7bea81e")
	)
	(text "C0G/NP0, ±10% or better\n10 V minimum,"
		(exclude_from_sim no)
		(at 313.0254 53.9243 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "c8001da5-e8b6-4bb8-992f-6a088dd21216")
	)
	(text "U1003: C1006 = 470 pF from CT to VIN gives approximately 1.9 ms\nturn-on and about 23 mA initial charging current into C1002, typical.\nQOD is tied to VOUT for controlled LOCAL_REG_VIN discharge."
		(exclude_from_sim no)
		(at 46.99 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "cc20a144-7e6c-4cf6-ab92-d00e56d2d4dc")
	)
	(text "KELVIN SENSE"
		(exclude_from_sim no)
		(at 170.1231 187.5374 0)
