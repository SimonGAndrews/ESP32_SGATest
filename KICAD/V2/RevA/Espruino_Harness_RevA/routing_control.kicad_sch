	(text "SWITCH FUNCTION\nEach TMUX1511 channel is bidirectional.\nEN=1 joins one R0-R6 entry to its named TI_* endpoint; EN=0 isolates it."
		(exclude_from_sim no)
		(at 135.89 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b7788b6b-5be3-451a-a88f-d164ddab182a")
	)
	(text "While ROUTING_LOGIC_3V3 is starting or invalid, U609 holds ROUTE_CLEAR_N low. \nThis resets both MCP23017s, leaving their GPIOs as high-impedance inputs. \nThe external 100 kΩ pull-downs then hold every TMUX1511 select input low, \nso all routing paths remain open.\nAfter the 3.3 V rail is valid for about 20 ms, U609 releases ROUTE_CLEAR_N; \nR634 pulls it high and firmware can configure the routing controllers"
		(exclude_from_sim no)
		(at 337.82 142.24 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "b8bbd3d4-a9cf-41f7-ac5a-74e559e330b6")
	)
