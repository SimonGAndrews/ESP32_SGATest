+#define UTIL_TIMER_DEBUG_LOG_LEN 32
+
+typedef enum {
+  UTDBG_RESET = 1,
+  UTDBG_INSERT,
+  UTDBG_START,
+  UTDBG_ISR,
+  UTDBG_SET,
+  UTDBG_RESCHED,
+  UTDBG_DISABLE,
+} UtilTimerDebugKind;
+
+typedef struct {
+  uint8_t kind;
+  uint8_t timerId;
+  uint8_t pin;
+  uint8_t value;
+  uint8_t head;
+  uint8_t tail;
+  int taskTime;
+  int period;
+} UtilTimerDebugEntry;
+
+static UtilTimerDebugEntry utilTimerDebugLog[UTIL_TIMER_DEBUG_LOG_LEN];
+static uint8_t utilTimerDebugLogHead = 0;
+static uint32_t utilTimerDebugLogCount = 0;
+static uint32_t utilTimerDebugInsertCount = 0;
+static uint32_t utilTimerDebugStartCount = 0;
+static uint32_t utilTimerDebugIsrCount = 0;
+static uint32_t utilTimerDebugSetCount = 0;
+static uint32_t utilTimerDebugReschedCount = 0;
+static uint32_t utilTimerDebugDisableCount = 0;
+
+static const char *jstUtilTimerDebugKindName(uint8_t kind) {
+  switch (kind) {
+    case UTDBG_RESET: return "reset";
+    case UTDBG_INSERT: return "insert";
+    case UTDBG_START: return "start";
+    case UTDBG_ISR: return "isr";
+    case UTDBG_SET: return "set";
+    case UTDBG_RESCHED: return "resched";
+    case UTDBG_DISABLE: return "disable";
+    default: return "unknown";
+  }
+}
+
+static inline void jstUtilTimerDebugLogEvent(uint8_t kind, uint8_t timerId, Pin pin, uint8_t value, int taskTime, int period) {
+  UtilTimerDebugEntry *entry = &utilTimerDebugLog[utilTimerDebugLogHead];
+  entry->kind = kind;
+  entry->timerId = timerId;
+  entry->pin = (uint8_t)pin;
+  entry->value = value;
+  entry->head = utilTimerTasksHead;
+  entry->tail = utilTimerTasksTail;
+  entry->taskTime = taskTime;
+  entry->period = period;
+  utilTimerDebugLogHead = (uint8_t)((utilTimerDebugLogHead + 1) % UTIL_TIMER_DEBUG_LOG_LEN);
+  utilTimerDebugLogCount++;
+}
+
+void jstUtilTimerDebugReset() {
+  utilTimerDebugLogHead = 0;
+  utilTimerDebugLogCount = 0;
+  utilTimerDebugInsertCount = 0;
+  utilTimerDebugStartCount = 0;
+  utilTimerDebugIsrCount = 0;
+  utilTimerDebugSetCount = 0;
+  utilTimerDebugReschedCount = 0;
+  utilTimerDebugDisableCount = 0;
+  for (int i = 0; i < UTIL_TIMER_DEBUG_LOG_LEN; i++) {
+    utilTimerDebugLog[i].kind = 0;
+    utilTimerDebugLog[i].timerId = 0;
+    utilTimerDebugLog[i].pin = 0;
+    utilTimerDebugLog[i].value = 0;
+    utilTimerDebugLog[i].head = 0;
+    utilTimerDebugLog[i].tail = 0;
+    utilTimerDebugLog[i].taskTime = 0;
+    utilTimerDebugLog[i].period = 0;
+  }
+  jstUtilTimerDebugLogEvent(UTDBG_RESET, 0, PIN_UNDEFINED, 0, 0, 0);
+}
+
+JsVar *jstUtilTimerDebugSnapshot() {
+  JsVar *debug = jsvNewObject();
+  JsVar *entries = jsvNewEmptyArray();
+  uint32_t entryCount = utilTimerDebugLogCount;
+  if (entryCount > UTIL_TIMER_DEBUG_LOG_LEN) entryCount = UTIL_TIMER_DEBUG_LOG_LEN;
+  uint32_t start = (utilTimerDebugLogHead + UTIL_TIMER_DEBUG_LOG_LEN - entryCount) % UTIL_TIMER_DEBUG_LOG_LEN;
+
+  jsvObjectSetChildAndUnLock(debug, "insertCount", jsvNewFromInteger(utilTimerDebugInsertCount));
+  jsvObjectSetChildAndUnLock(debug, "startCount", jsvNewFromInteger(utilTimerDebugStartCount));
+  jsvObjectSetChildAndUnLock(debug, "isrCount", jsvNewFromInteger(utilTimerDebugIsrCount));
+  jsvObjectSetChildAndUnLock(debug, "setCount", jsvNewFromInteger(utilTimerDebugSetCount));
+  jsvObjectSetChildAndUnLock(debug, "reschedCount", jsvNewFromInteger(utilTimerDebugReschedCount));
+  jsvObjectSetChildAndUnLock(debug, "disableCount", jsvNewFromInteger(utilTimerDebugDisableCount));
+  jsvObjectSetChildAndUnLock(debug, "utilTimerOn", jsvNewFromBool(utilTimerOn));
+  jsvObjectSetChildAndUnLock(debug, "utilTimerPeriod", jsvNewFromInteger(utilTimerPeriod));
+  jsvObjectSetChildAndUnLock(debug, "utilTimerOffset", jsvNewFromInteger(utilTimerOffset));
+  jsvObjectSetChildAndUnLock(debug, "queueHead", jsvNewFromInteger(utilTimerTasksHead));
+  jsvObjectSetChildAndUnLock(debug, "queueTail", jsvNewFromInteger(utilTimerTasksTail));
+
+  for (uint32_t i = 0; i < entryCount; i++) {
+    const UtilTimerDebugEntry *entry = &utilTimerDebugLog[(start + i) % UTIL_TIMER_DEBUG_LOG_LEN];
+    JsVar *entryObj = jsvNewObject();
+    jsvObjectSetChildAndUnLock(entryObj, "kind", jsvNewFromString(jstUtilTimerDebugKindName(entry->kind)));
+    jsvObjectSetChildAndUnLock(entryObj, "timerId", jsvNewFromInteger(entry->timerId));
+    jsvObjectSetChildAndUnLock(entryObj, "pin", jsvNewFromInteger(entry->pin));
+    jsvObjectSetChildAndUnLock(entryObj, "value", jsvNewFromInteger(entry->value));
+    jsvObjectSetChildAndUnLock(entryObj, "taskTime", jsvNewFromInteger(entry->taskTime));
+    jsvObjectSetChildAndUnLock(entryObj, "period", jsvNewFromInteger(entry->period));
+    jsvObjectSetChildAndUnLock(entryObj, "head", jsvNewFromInteger(entry->head));
+    jsvObjectSetChildAndUnLock(entryObj, "tail", jsvNewFromInteger(entry->tail));
+    jsvArrayPushAndUnLock(entries, entryObj);
+  }
+
+  jsvObjectSetChildAndUnLock(debug, "entries", entries);
+  return debug;
+}
+
 
