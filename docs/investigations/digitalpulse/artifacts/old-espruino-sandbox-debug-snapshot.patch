+#define PIN_DEBUG_LOG_LEN 32
+
+typedef struct {
+  uint8_t pin;
+  uint8_t requestedValue;
+  uint8_t rawBefore;
+  uint8_t rawAfter;
+  uint8_t logicalAfter;
+  uint8_t inIsr;
+} PinDebugEntry;
+
+static PinDebugEntry pinDebugLog[PIN_DEBUG_LOG_LEN];
+static uint8_t pinDebugLogHead = 0;
+static uint32_t pinDebugLogCount = 0;
+static uint32_t pinDebugSetCount = 0;
+
+static inline void jshPinDebugLog(Pin pin, bool requestedValue, bool rawBefore, bool rawAfter, bool logicalAfter, bool inIsr) {
+  PinDebugEntry *entry = &pinDebugLog[pinDebugLogHead];
+  entry->pin = (uint8_t)pin;
+  entry->requestedValue = requestedValue ? 1 : 0;
+  entry->rawBefore = rawBefore ? 1 : 0;
+  entry->rawAfter = rawAfter ? 1 : 0;
+  entry->logicalAfter = logicalAfter ? 1 : 0;
+  entry->inIsr = inIsr ? 1 : 0;
+  pinDebugLogHead = (uint8_t)((pinDebugLogHead + 1) % PIN_DEBUG_LOG_LEN);
+  pinDebugLogCount++;
+  pinDebugSetCount++;
+}
+
+void jshPinDebugReset(void) {
+  pinDebugLogHead = 0;
+  pinDebugLogCount = 0;
+  pinDebugSetCount = 0;
+  for (int i = 0; i < PIN_DEBUG_LOG_LEN; i++) {
+    pinDebugLog[i].pin = 0;
+    pinDebugLog[i].requestedValue = 0;
+    pinDebugLog[i].rawBefore = 0;
+    pinDebugLog[i].rawAfter = 0;
+    pinDebugLog[i].logicalAfter = 0;
+    pinDebugLog[i].inIsr = 0;
+  }
+}
+
+JsVar *jshPinDebugSnapshot(void) {
+  JsVar *debug = jsvNewObject();
+  JsVar *entries = jsvNewEmptyArray();
+  uint32_t entryCount = pinDebugLogCount;
+  if (entryCount > PIN_DEBUG_LOG_LEN) entryCount = PIN_DEBUG_LOG_LEN;
+  uint32_t start = (pinDebugLogHead + PIN_DEBUG_LOG_LEN - entryCount) % PIN_DEBUG_LOG_LEN;
+
+  jsvObjectSetChildAndUnLock(debug, "setCount", jsvNewFromInteger(pinDebugSetCount));
+
+  for (uint32_t i = 0; i < entryCount; i++) {
+    const PinDebugEntry *entry = &pinDebugLog[(start + i) % PIN_DEBUG_LOG_LEN];
+    JsVar *entryObj = jsvNewObject();
+    jsvObjectSetChildAndUnLock(entryObj, "pin", jsvNewFromInteger(entry->pin));
+    jsvObjectSetChildAndUnLock(entryObj, "requestedValue", jsvNewFromInteger(entry->requestedValue));
+    jsvObjectSetChildAndUnLock(entryObj, "rawBefore", jsvNewFromInteger(entry->rawBefore));
+    jsvObjectSetChildAndUnLock(entryObj, "rawAfter", jsvNewFromInteger(entry->rawAfter));
+    jsvObjectSetChildAndUnLock(entryObj, "logicalAfter", jsvNewFromInteger(entry->logicalAfter));
+    jsvObjectSetChildAndUnLock(entryObj, "inIsr", jsvNewFromInteger(entry->inIsr));
+    jsvArrayPushAndUnLock(entries, entryObj);
+  }
+
+  jsvObjectSetChildAndUnLock(debug, "entries", entries);
+  return debug;
+}
